# Copy this file to .env and fill in your own values. Never commit .env.
# Create API credentials at https://my.telegram.org -> "API development tools".
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Phone number of your Telegram account, international format (used only to request the login code).
TELEGRAM_PHONE=

# Optional: only if you want to run in bot mode instead of signing in with your account.
TELEGRAM_BOT_TOKEN=

# Defaults used on first start (afterwards the values in Settings are used).
SCAN_INTERVAL_SECONDS=60
MEMBER_SYNC_MINUTES=30
HISTORY_BACKFILL=300
MIN_RELEVANCE_SCORE=50
JOINED_BEFORE=2025-01-01
NOTIFICATIONS_ENABLED=true

# Optional: store the database, session, avatars and logs somewhere else.
# TLM_DATA_DIR=
